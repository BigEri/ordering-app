# --- Databáze (povinné v produkci) ---
# PostgreSQL — lokálně nebo Neon na Vercelu (pooled URL pro runtime).
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
#
# Migrace z PC použijte direct URL (Neon → Connection details → Direct):
#   npx prisma migrate deploy

# Sentry (volitelné — bez DSN se SDK neinicializuje)

# Klient: instrumentation-client.ts + sentry.*.config (server/edge přes instrumentation.ts)

# Veřejné pro klienta i build:

NEXT_PUBLIC_SENTRY_DSN=

NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Volitelně jen na serveru (stejné DSN jako výše):

SENTRY_DSN=

# SENTRY_ENVIRONMENT=production



# POS webhook (kontrola v /api/health)

# POS_NOTIFICATION_URL=

#
#
# --- Admin (multi-restaurant) ---
#
# Podepisování session cookie (lib/server/auth.ts) – náhodný dlouhý řetězec.
# APP_AUTH_SECRET=
#
# Jednorázové založení prvního SUPER_ADMIN + první restaurace:
# POST /api/admin/bootstrap (Authorization: Bearer <token>)
# BOOTSTRAP_TOKEN=
#
# Vendor-only remote provisioning (e.g. add locales after install):
# POST /api/admin/locales (Authorization: Bearer <token>)
# PROVISION_TOKEN=
#
# Při více restauracích v DB: UUID provozovny, jejíž název se má zobrazit hostům (úvod, menu, záhlaví).
# PUBLIC_RESTAURANT_ID=
#


# --- Dotykačka (API v2) — synchronizace objednávek na pokladnu ---

#

# 1) OAuth (nový refresh token): v prohlížeči otevřete

#    GET /api/integrations/dotykacka/connect

#    (vyžaduje níže CLIENT_ID + CLIENT_SECRET a NEXT_PUBLIC_APP_URL)

# DOTYKACKA_CLIENT_ID=

# DOTYKACKA_CLIENT_SECRET=

# Veřejná URL aplikace (redirect_uri), např. http://localhost:3000

# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Šifrování refresh tokenu v DB (doporučené pro multi-restaurant).
# Nastavte stabilní tajný klíč (32 bytes). Formát:
# - 64 hex znaků (doporučeno) nebo
# - base64 nebo
# - libovolný řetězec (z něj se udělá SHA-256).
#
# DOTYKACKA_TOKEN_ENCRYPTION_KEY=

#

# 2) Po kliknutí „Allow“ zkopírujte z callback stránky / z URL:

# DOTYKACKA_REFRESH_TOKEN=

# DOTYKACKA_CLOUD_ID=374619822

#

# 3) branchId: GET /v2/clouds/:cloudId/branches (Bearer access token s _cloudId)

#    nebo z odpovědi GET .../tables u položky _branchId

# DOTYKACKA_BRANCH_ID=118756313

#

# 4) Stůl v /admin/devices: „Číslo / ID stolu“ = data[0].id z

#    GET /v2/clouds/:cloudId/tables → response.data[].id (např. 234210637266778)

#

# 5) Volitelné mapování: jen když menuItemId není číslo z API (kladné i záporné).

#    Klíč = řetězec z menu, hodnota = product id v Dotyce (GET .../products).

# DOTYKACKA_PRODUCT_MAP_JSON={"hlavni-svickova":111111,"hlavni-gulas":222222}

#

# Menu z Dotyky: produkty v kategoriích Ingredience / Přílohy / Sides… (pool pro customizace)

#    se v kiosku nezobrazí jako samostatné položky (zůstanou u burgeru/řízku apod.). Doplňte ID nebo regex:

# DOTYKACKA_MENU_HIDE_CATEGORY_IDS=123456,789012

# DOTYKACKA_MENU_HIDE_CATEGORY_NAME_REGEX=^Ingredience

#

# Pokud 1: u volitelných customizací (min 0) se v kiosku zobrazí všechny produkty

# z kategorie; jinak se při neprázdném _defaultProductIds zobrazí jen tato podmnožina

# (např. skryje „maso navíc“, pokud není v defaultech v Dotyce).

# DOTYKACKA_MENU_CUSTOMIZATION_NO_DEFAULT_SUBSET_FILTER=

#

# Volitelné:

# DOTYKACKA_API_BASE=https://api.dotykacka.cz

# Pokud 1, selhání Dotyky vrátí HTTP 502 u /api/pos/order-confirmed

# DOTYKACKA_FAIL_ON_ERROR=

#
# --- Trvalé úložiště obrázků (menu + úvodní stránka) — povinné na Vercelu ---
#
# Bez těchto proměnných se soubory ukládají do public/uploads/ (při redeploy zmizí).
# Doporučeno: Cloudflare R2 (S3 API) nebo AWS S3 + veřejná CDN doména.
#
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_BASE=https://pub-xxxx.r2.dev   (veřejná URL bucketu — NE API endpoint)
# S3_REGION=auto
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com   (povinné pro R2 upload)
# S3_FORCE_PATH_STYLE=1   (u R2 se zapne automaticky, pokud není 0)

