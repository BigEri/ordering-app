# =============================================================================
# ordering-app — přehled proměnných prostředí (BEZ tajemství v repozitáři)
# =============================================================================
# Zkopírujte jako `.env.local` (lokálně) nebo nastavte u hostingu.
# Reálné hodnoty (.env, .env.local) necommitujte — jsou v .gitignore.
#
# SQLite: výchozí cesta je `data/app.db` (viz lib/server/db.ts), bez env.
# =============================================================================

# --- Admin / session (povinné v produkci) ------------------------------------
# Tajný klíč pro podpis session cookie po přihlášení (lib/server/auth.ts).
APP_AUTH_SECRET=

# --- Veřejné menu / výběr provozovny -----------------------------------------
# UUID výchozí provozovny pro hosty bez kontextu tabletu (úvod /, /menu, název v záhlaví).
# Použije se, když v DB běží více provozoven a návštěvník nemá vazbu zařízení ani cookie
# oa_menu_rid (typicky anonymní okno na app.tableflow.cz).
#
# Multi-tenant produkce (Tableflow + klienti): nastavte UUID vaší ukázkové provozovny
# Tableflow — ne klientské. Jinak anonymní návštěvník může vidět fotky/název náhodné
# provozovny (pokud je v DB jen jedna, nebo má prohlížeč cookie z testu párování).
# U ukázkové provozovny: Admin → Úvodní stránka → neutrální fotky nebo výchozí /images/.
#
# Priorita host menu: vazba tabletu → admin náhled (?from=admin) → provozovna personálu →
# oa_menu_rid → PUBLIC_RESTAURANT_ID. Spárovaný tablet u stolu klienta vždy ukáže jeho restauraci.
# Viz lib/server/publicMenuRestaurantResolve.ts.
PUBLIC_RESTAURANT_ID=
#
# Cookie oa_menu_rid — klient si ji nastaví po párování zařízení (POST /api/public/kiosk-menu-cookie).
# Odkaz /menu?rid=<uuid> funguje bez cookie (záložní výběr).

# Veřejná URL aplikace (bez koncového /). OAuth callback Dotykačky
# (app/api/integrations/dotykacka/connect/route.ts). Na Vercelu lze spoléhat na VERCEL_URL.
NEXT_PUBLIC_APP_URL=https://vase-domena.example

# --- Dotykačka (API v2) ------------------------------------------------------
# Načtení menu + sync objednávek do pokladny (lib/dotykacka/config.ts, forwardPos).
# Při OAuth z administrace: pokud cloud v DB = DOTYKACKA_CLOUD_ID, doplní se z .env pobočka a mapa,
# dokud je v DB neuložíte ručně (více provozoven: každá má vlastní řádek restaurant_dotykacka).
DOTYKACKA_REFRESH_TOKEN=
DOTYKACKA_CLOUD_ID=
DOTYKACKA_BRANCH_ID=
# JSON mapa: klíč = id položky v aplikaci → číslo product id v Dotyce (povinné pro sync objednávek).
DOTYKACKA_PRODUCT_MAP_JSON={}
# Volitelně: product id 0 Kč položky „Přivolání obsluhy“ (nebo klíč oa-staff-call v mapě výše)
# DOTYKACKA_STAFF_CALL_PRODUCT_ID=
# Volitelně: product id 0 Kč položky „Žádost o platbu“ (nebo klíč oa-bill-request)
# DOTYKACKA_BILL_REQUEST_PRODUCT_ID=
# Rezerva: table id stolu mimo hosty (teď se nepoužívá; nebo klíč oa-signal-table)
# DOTYKACKA_SIGNAL_TABLE_ID=

# Volitelné — výchozí https://api.dotykacka.cz
# DOTYKACKA_API_BASE=https://api.dotykacka.cz

# OAuth klient (když používáte connect flow) — lib/dotykacka/config.ts getDotykackaOAuthClientConfig
# DOTYKACKA_CLIENT_ID=
# DOTYKACKA_CLIENT_SECRET=

# Pokud sync objednávky do Dotykačky selže: ne „ok“ tiše (výchozí). Vypnutí: DOTYKACKA_FAIL_ON_ERROR=0
# DOTYKACKA_FAIL_ON_ERROR=1

# pos-actions: vlastní webhook (lib/dotykacka/syncOrder.ts, posWebhookBase.ts)
# Bez veřejného HTTPS často HTTP 404 s {} i při správné pobočce (výchozí webhook Dotykačky).
# NEXT_PUBLIC_APP_URL musí být skutečná adresa nasazení (https://…). Lokální vývoj: ngrok + tato URL.
# DOTYKACKA_POS_WEBHOOK_PUBLIC_BASE_URL=https://vase-domena.example
# DOTYKACKA_POS_WEBHOOK_MAX_MS=45000
# DOTYKACKA_POS_WEBHOOK=0

# Skrýt z kiosku kategorie Ingredience / Přílohy (pool pro customizace) — lib/dotykacka/menuCategoryFilter.ts
# DOTYKACKA_MENU_HIDE_CATEGORY_NAME_REGEX=
# DOTYKACKA_MENU_HIDE_CATEGORY_IDS=

# Úprava chování načítání menu (lib/dotykacka/fetchProducts.ts)
# DOTYKACKA_MENU_CUSTOMIZATION_NO_DEFAULT_SUBSET_FILTER=1

# --- POS / externí notifikace -----------------------------------------------
# Kam POSTovat události z /api/pos/* (lib/pos/forwardPos.ts). Prázdné = jen virtuální log + Dotykačka.
# Není to webhook Dotykačky ani podmínka pro pos-actions — chybějící hodnota neblokuje odeslání do pokladny.
# Nastavte jen pokud chcete duplicitně posílat JSON { type, payload, tsIso } na vlastní backend.
POS_NOTIFICATION_URL=

# Volitelná hlavička x-api-key při forwardu na POS_NOTIFICATION_URL
# POS_API_KEY=

# --- Jednorázové admin endpointy --------------------------------------------
# Ochrana POST /api/admin/bootstrap (vytvoření prvního admina apod.)
# Po nastavení token otevřete v prohlížeči /setup (nebo /setup?token=…) a vyplňte formulář —
# pohodlnější než ruční curl. Po vytvoření prvního uživatele endpoint vrací 409.
BOOTSTRAP_TOKEN=
#
# Párování kiosku: tablet zobrazí na /menu šestimístný kód; majitel ho zadá v adminu na /admin/devices/pair-kiosk.

# Ochrana zápisu jazyků POST /api/admin/locales (app/api/admin/locales/route.ts)
PROVISION_TOKEN=

# --- Sentry (volitelné) ------------------------------------------------------
# SENTRY_DSN nebo NEXT_PUBLIC_SENTRY_DSN — sentry.*.config.ts, instrumentation-client.ts
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# --- Supabase (volitelné — jen pokud modul používáte) -----------------------
# lib/supabase/client.ts
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Dotykačka per provozovna (databáze) ------------------------------------
# OAuth z administrace: Detail restaurace → záložka Dotykačka → „Připojit Dotykačku“.
# Uložené údaje přebíjí níže uvedené DOTYKACKA_* pro danou restauraci (PUBLIC_RESTAURANT_ID
# nebo jediná restaurace v DB určuje veřejné menu). Bez záznamu v DB platí jen .env.

# --- Hosting (často automaticky) --------------------------------------------
# Na Vercelu nastavuje platforma — používá se jako fallback base URL u Dotykačky OAuth.
# VERCEL_URL=

# NODE_ENV nastavuje Next/Node (development | production) — nemusíte ručně při next dev.
